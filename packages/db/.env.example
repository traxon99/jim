# Supabase Postgres connection string used by drizzle-kit, db:migrate and db:seed.
# Use the pooler/direct connection string from the Supabase project settings.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Scratch database for `pnpm test`. Integration tests are skipped when unset.
# Never point this at a database with real data — tests drop and recreate schemas.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/jim_test

# Optional override for db:migrate only — takes precedence over DATABASE_URL.
# apps/web's build runs db:migrate automatically; in that context this should
# be the Supabase SESSION pooler string, since migrations take a
# session-scoped advisory lock the transaction pooler doesn't support.
MIGRATE_DATABASE_URL=
