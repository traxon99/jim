# Direct Postgres connection, impersonated per-request via RLS (see
# src/context.ts / @jim/db's runAsUser) — never a service-role key (ADR-006).
# Use the pooler/transaction-mode connection string in deployed environments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Supabase project settings → API. Used only to call Supabase's own Auth API
# (magic-link sign-in, JWT verification) — the anon key is not a secret; RLS
# is what protects data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# This server's own public origin — the OAuth 2.1 issuer, and the base for
# the magic-link redirect Supabase sends the user back to. Must be added to
# the Supabase project's Auth → URL Configuration → Redirect URLs allowlist
# as `<MCP_ISSUER_URL>/login/callback`. Defaults to http://localhost:$PORT
# for local dev (HTTP is only permitted for localhost — see router.js's
# checkIssuerUrl); a deployed server must use its real HTTPS origin.
MCP_ISSUER_URL=http://localhost:3001

PORT=3001
