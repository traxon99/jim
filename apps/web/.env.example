# Supabase project settings → API. The anon key is safe to expose to the browser;
# RLS (see packages/db, ADR-005) is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection for the sync API routes (POST/GET /api/sync/push,pull).
# These impersonate the request's verified user via SET LOCAL ROLE — see
# lib/db/user-scoped.ts — so this should be a role that can assume `authenticated`
# (Supabase's default connection role already can), never a service-role key.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Scratch database for `pnpm test`. Integration tests are skipped when unset.
# Never point this at a database with real data — tests drop and recreate schemas.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/jim_test

# Runs automatically before every production build (apps/web's `prebuild`
# script runs @jim/db's db:migrate) so deploys apply pending migrations on
# their own. Preview builds (VERCEL_ENV=preview) skip it — they share the
# production database, and an unmerged branch mustn't migrate it.
# Set this in Vercel's Environment Variables (Build-time) to the SESSION
# pooler string (port 5432), not the transaction pooler DATABASE_URL above —
# drizzle's migrator takes a session-scoped advisory lock that transaction
# mode doesn't support. Falls back to DATABASE_URL when unset.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Profile → Feedback (POST /api/feedback) files each submission as a GitHub
# issue via the REST API. GITHUB_FEEDBACK_REPO is "owner/repo"; the token
# needs "Issues: write" for that repo (a fine-grained PAT scoped to just it
# is enough — never a broad classic token).
GITHUB_FEEDBACK_REPO=your-org/your-repo
GITHUB_FEEDBACK_TOKEN=github_pat_your-token

# App version (lib/version/resolve.ts): on Vercel builds, the patch number is
# counted via the GitHub API because Vercel's shallow clone lacks the history.
# Needs a fine-grained PAT with "Contents: read" on this app's repo. Without
# it, production builds show "<major>.<minor>.0-dev". Build-time only.
GITHUB_VERSION_TOKEN=github_pat_your-token
